{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexQ Recorder",
  "version": "0.1.0",
  "identifier": "com.nexq.recorder",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NexQ Recorder",
        "width": 1120,
        "height": 740,
        "minWidth": 420,
        "minHeight": 350,
        "backgroundColor": "#fafafb"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": { "../LICENSE": "LICENSE.txt" },
    "shortDescription": "Private dual-track audio recording",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true }
    }
  }
}
